rules_version = '2';

// Seul contrôle côté serveur du projet (pas de backend) : toute la validation des tampons passe ici.
//
// Modèle de données
//   staff/{uid}                     compte équipe (créé à la main dans la console, jamais depuis le site)
//   cards/{cardId}                  { ownerUid, firstName, stamps, stampsBlue, lastStamp, createdAt, lastEventId?, recoveredWith? }
//   cards/{cardId}/history/{id}     { type: 'stamp' | 'reward', card: 'green' | 'blue', at, staffUid }
//                                   journal, jamais modifié ni lu depuis le site
//
// Deux cartes sur le même document : verte = stamps, bleue = stampsBlue (absent sur les cartes créées
// avant la carte bleue : lu comme 0). Chacune va de 0 à 10 ; le délai d'une heure (lastStamp) est commun.
//   cards/{cardId}/private/recovery { code }                                     code de la carte, lisible par son seul propriétaire
//   recovery/{code}                 { cardId }                                   code de secours, 10 caractères
//
// Cloisonnement des clients : un client ne lit et n'écrit que sa propre carte (ownerUid). Il ne peut ni lister
// les cartes, ni lire l'historique, ni modifier ses tampons. Seule passerelle entre deux
// identités : le code de secours, qui transfère la carte à qui le connaît (risque accepté par le projet).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Un compte équipe se connecte par email (jamais en anonyme) et possède un document staff/{uid}.
    function isStaff() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    // Alphabet sans caractères ambigus (pas de 0/O, 1/I/L), 10 caractères stockés sans tirets.
    function isRecoveryCode(code) {
      return code is string && code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{10}$');
    }

    function cardPath(cardId) {
      return /databases/$(database)/documents/cards/$(cardId);
    }

    match /staff/{uid} {
      // Permet à l'espace équipe de vérifier que le compte connecté est bien un compte équipe.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /cards/{cardId} {
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Événement d'historique écrit dans le même batch que la modification de la carte.
      function newEvent() {
        return getAfter(/databases/$(database)/documents/cards/$(cardId)/history/$(request.resource.data.lastEventId)).data;
      }

      // Compteur de la carte verte ('stamps') ou bleue ('stampsBlue', 0 s'il n'existe pas encore).
      function counter(data, field) {
        return data.get(field, 0);
      }

      // +1 tampon exactement sur UN seul compteur, au plus un par heure toutes cartes confondues
      // (lastStamp commun), journalisé avec la carte tamponnée.
      function isStamp(field, card) {
        return changedKeys().hasOnly([field, 'lastStamp', 'lastEventId'])
          && counter(resource.data, field) < 10
          && request.resource.data[field] == counter(resource.data, field) + 1
          && request.resource.data.lastStamp == request.time
          && (resource.data.lastStamp == null
              || request.time > resource.data.lastStamp + duration.value(1, 'h'))
          && newEvent().type == 'stamp'
          && newEvent().card == card
          && newEvent().at == request.time;
      }

      // Remise du cadeau : uniquement sur une carte pleine, remise à 0 de cette carte seule, journalisée.
      function isReward(field, card) {
        return changedKeys().hasOnly([field, 'lastEventId'])
          && counter(resource.data, field) == 10
          && request.resource.data[field] == 0
          && newEvent().type == 'reward'
          && newEvent().card == card
          && newEvent().at == request.time;
      }

      function isCardChange(field, card) {
        return isStamp(field, card) || isReward(field, card);
      }

      // Changement de téléphone : la carte passe au nouvel uid anonyme sur présentation du code de secours.
      function isRecovery() {
        let code = request.resource.data.recoveredWith;
        let recoveryPath = /databases/$(database)/documents/recovery/$(code);
        return signedIn()
          && changedKeys().hasOnly(['ownerUid', 'recoveredWith'])
          && request.resource.data.ownerUid == request.auth.uid
          && code is string
          && exists(recoveryPath)
          && get(recoveryPath).data.cardId == cardId;
      }

      allow get: if (signedIn() && resource.data.ownerUid == request.auth.uid) || isStaff();
      allow list: if isStaff();

      // La carte, son code de secours (recovery/{code}) et sa copie privée (private/recovery)
      // sont créés ensemble, dans le même batch.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'firstName', 'stamps', 'stampsBlue', 'lastStamp', 'createdAt'])
        && request.resource.data.keys().hasAll(['ownerUid', 'firstName', 'stamps', 'stampsBlue', 'lastStamp', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 40
        && request.resource.data.stamps == 0
        && request.resource.data.stampsBlue == 0
        && request.resource.data.lastStamp == null
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/cards/$(cardId)/private/recovery);

      allow update: if (isStaff() && (isCardChange('stamps', 'green') || isCardChange('stampsBlue', 'blue'))) || isRecovery();
      allow delete: if false;

      // Code de secours de la carte : l'équipe ne le voit jamais (pas de fuite de tous les codes via un compte équipe).
      match /private/{docId} {
        allow get: if signedIn() && get(cardPath(cardId)).data.ownerUid == request.auth.uid;
        allow list, update, delete: if false;

        allow create: if docId == 'recovery'
          && signedIn()
          && getAfter(cardPath(cardId)).data.ownerUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['code'])
          && isRecoveryCode(request.resource.data.code)
          && getAfter(/databases/$(database)/documents/recovery/$(request.resource.data.code)).data.cardId == cardId;
      }

      match /history/{eventId} {
        // Journal non consultable depuis le site (ni client ni équipe) : uniquement depuis la console Firebase.
        allow read: if false;

        // Un événement n'existe que s'il accompagne la modification de la carte qui le référence.
        allow create: if isStaff()
          && request.resource.data.keys().hasOnly(['type', 'card', 'at', 'staffUid'])
          && request.resource.data.type in ['stamp', 'reward']
          && request.resource.data.card in ['green', 'blue']
          && request.resource.data.at == request.time
          && request.resource.data.staffUid == request.auth.uid
          && getAfter(cardPath(cardId)).data.lastEventId == eventId;

        allow update, delete: if false;
      }
    }

    match /recovery/{code} {
      // Lecture par code exact uniquement : impossible de parcourir les codes.
      allow get: if signedIn();
      allow list, update, delete: if false;

      allow create: if signedIn()
        && isRecoveryCode(code)
        && request.resource.data.keys().hasOnly(['cardId'])
        && request.resource.data.cardId is string
        && getAfter(cardPath(request.resource.data.cardId)).data.ownerUid == request.auth.uid;
    }
  }
}
